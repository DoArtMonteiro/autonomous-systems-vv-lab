      "min_y_mm": 0,
      "max_y_mm": 10000
    },
    "restricted_zone": {
      "vertices": [
        {
          "x_mm": 7000,
          "y_mm": 7000
        },
        {
          "x_mm": 8500,
          "y_mm": 7000
        },
        {
          "x_mm": 8500,
          "y_mm": 8500
        },
        {
          "x_mm": 7000,
          "y_mm": 8500
        }
      ]
    },
    "vehicle": {
      "start": {
        "x_mm": 1000,
        "y_mm": 1000
      },
      "heading": "east",
      "step_mm": 500
    },
    "mission": {
      "waypoints": [
        {
          "x_mm": 1250,
          "y_mm": 3000
        }
      ],
      "arrival_radius_mm": 250
    },
    "sensors": {
      "gps": {
        "dropout_windows": [],
        "dropout_permille": 0,
        "noise_max_mm": 0
