      "communication": {
        "packet_loss_windows": [],
        "packet_loss_permille": 0,
        "delay_min_ticks": 0,
        "delay_max_ticks": 0
      },
      "max_observation_age_ticks": 3
    },
    "validation_mutants": []
  },
  "contracts": {
    "schema_version": 1,
    "contracts": [
      {
        "type": "always",
        "id": "restricted_zone_clear",
        "predicate": "restricted_zone_clear"
      },
      {
