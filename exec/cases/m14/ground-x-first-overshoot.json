        "correlation": "command_id"
      },
      {
        "type": "bounded_response",
        "id": "command_applied",
        "trigger": "movement_commanded",
        "required": "command_applied",
        "within_ticks": 2,
        "correlation": "command_id"
      },
      {
        "type": "never",
        "id": "no_motion_in_fallback",
        "predicate": "movement_while_fallback"
      },
      {
        "type": "ordered_transition",
        "id": "mission_lifecycle",
        "domain": "mission",
        "sequence": [
          {
            "from": "pending",
            "to": "running"
          },
          {
            "from": "running",
            "to": "completed"
          }
        ]
      }
    ]
