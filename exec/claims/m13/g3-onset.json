{
  "schema": "vv-claim.v1",
  "id": "g3-onset",
  "title": "G3 under a late GNSS bias",
  "statement": "The guarded M9.1 controller touches down within R1 (vertical speed at most 3 m/s) when the GNSS position is biased by 5 to 30 m, whenever the bias starts within the first 20 s of the flight.",
  "origin": "Derived from M9.1 criterion G3 (docs/m9-powered-landing.md), registered and supported only with the bias present from 0 s: R1 met in at least 27 of 30 runs. This claim extends the onset to 0-20 s as a separate, new hypothesis; it does not change G3. M14 (docs/m14-evidence-robustness.md) reported that onsets of 2, 5 and 10 s at 5 and 10 m fail.",
  "domain": "rocket-landing",
  "base_case": "../../cases/m13/g3-registered.json",
  "property": "requirement:R1_vertical_speed",
  "tolerance": 0.1,
  "objective": {
    "metric": "requirement.R1_vertical_speed",
    "direction": "minimise"
  },
  "assumptions": [
    {
      "parameter": {
        "name": "onset_s",
        "pointer": "/faults/0/start_s",
        "unit": "s",
        "low": 0.0,
        "high": 20.0,
        "quantum": 0.01
      },
      "description": "Instant the GNSS bias starts. Registered at 0 s."
    },
    {
      "parameter": {
        "name": "magnitude_m",
        "pointer": "/faults/0/magnitude",
        "unit": "model",
        "low": 5.0,
        "high": 30.0
      },
      "description": "GNSS position bias in x and z. Registered as uniform draws over [5, 30] m; the base case uses 15 m."
    }
  ],
  "seeds": {
    "discovery": {
      "low": 42000,
      "high": 42999
    },
    "evaluation": {
      "low": 43000,
      "high": 43499
    },
    "regression": {
      "low": 43500,
      "high": 43999
    }
  },
  "budget": {
    "baseline_seeds": 30,
    "challenge": 400,
    "minimise": 120,
    "replication_seeds": 30,
    "envelope_levels": 16,
    "envelope_seeds": 4,
    "mechanism_seeds": 30,
    "regression_points": 60
  },
  "search_seed": 13,
  "strategy": {
    "kind": "halton"
  },
  "hypotheses": [
    {
      "id": "masking",
      "statement": "Sub-threshold masking: after a late onset the estimator blends the biased GNSS with an altimeter it still accepts, so the residual stays under the 3 m rejection threshold, the altimeter is never rejected, rule 1 never engages and the believed vertical motion is wrong. With the bias from 0 s, the estimator starts on the biased GNSS, the residual exceeds the threshold at once and the altimeter is rejected.",
      "interventions": [
        {
          "id": "threshold-1m",
          "description": "Lower the altimeter rejection threshold from 3 m to 1 m, below the predicted blended residual.",
          "at": "counterexample",
          "overrides": [
            {
              "pointer": "/controller/gains/altimeter_residual_threshold_m",
              "value": 1.0
            }
          ],
          "predicts": "holds"
        },
        {
          "id": "no-altimeter-blend",
          "description": "Remove the altimeter from the estimator (position and velocity gains 0): no blending is left to mask the bias.",
          "at": "counterexample",
          "overrides": [
            {
              "pointer": "/controller/gains/altimeter_position_gain",
              "value": 0.0
            },
            {
              "pointer": "/controller/gains/altimeter_velocity_gain",
              "value": 0.0
            }
          ],
          "predicts": "holds"
        }
      ],
      "trace_checks": [
        {
          "id": "never-rejected",
          "description": "The estimator never rejects the altimeter in the counterexample runs.",
          "samples": "/samples",
          "pointer": "/estimate/altimeter_rejected",
          "predicate": "never_true"
        },
        {
          "id": "velocity-belief-wrong",
          "description": "The believed vertical velocity is wrong by at least 1 m/s at some sample.",
          "samples": "/samples",
          "pointer": "/estimate/velocity_mps/2",
          "minus": "/truth/velocity_mps/2",
          "predicate": "max_abs_at_least",
          "threshold": 1.0
        }
      ]
    },
    {
      "id": "velocity-coupling",
      "statement": "Competing explanation: the failure travels through the altimeter velocity correction alone (the residual divided by the cycle time, fed into the velocity estimate).",
      "interventions": [
        {
          "id": "no-velocity-correction",
          "description": "Set the altimeter velocity gain to 0 and keep the altimeter position correction.",
          "at": "counterexample",
          "overrides": [
            {
              "pointer": "/controller/gains/altimeter_velocity_gain",
              "value": 0.0
            }
          ],
          "predicts": "holds"
        }
      ]
    }
  ],
  "mitigations": [
    {
      "id": "threshold-1m",
      "title": "Altimeter rejection threshold 1 m",
      "rationale": "If masking is the mechanism, a threshold below the blended residual makes the estimator reject the altimeter after a late onset as it does after an onset at 0 s, which lets rule 1 act.",
      "overrides": [
        {
          "pointer": "/controller/gains/altimeter_residual_threshold_m",
          "value": 1.0
        }
      ]
    },
    {
      "id": "threshold-2m",
      "title": "Altimeter rejection threshold 2 m",
      "rationale": "A smaller change of the same gain, to see whether the trade-off depends on how far the threshold moves.",
      "overrides": [
        {
          "pointer": "/controller/gains/altimeter_residual_threshold_m",
          "value": 2.0
        }
      ]
    }
  ],
