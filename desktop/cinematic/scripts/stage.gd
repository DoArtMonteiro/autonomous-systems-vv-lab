# Illustrative first stage. The model is authored in Blender (desktop/cinematic/assets-src/
# build_stage.py, regenerated byte for byte into assets/stage.glb) with the dimensions of
# desktop/studio/ui/js/scenes/stage-model.js: radius 1.85 m, 42 m from the nozzle exit plane to the
# top of the interstage, tank 3.2 to 35.5 m. The landing model is a rigid body with no length, gear or
# control surfaces, and the run record has no leg, fin or gimbal state: the legs stay stowed, the grid
# fins fixed and the bells straight. The plume length follows the recorded applied throttle only.
# Body frame: +x along the stage axis from the nozzle exit plane.
extends RefCounted

const Assets := preload("res://scripts/assets.gd")

const RADIUS := 1.85
const LENGTH := 42.0
const TANK := [3.2, 35.5]
const ENGINE_SPOTS := 7


# Unit flame mesh along -y (y = 0 at the nozzle exit plane, -1 at the tip), radius 1 at its widest;
# UV.x around, UV.y = distance along the flame (0 to 1). Scaled by the caller to metres.
static func _flame_mesh(rings: int, segs: int) -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var grid := []
	for i in rings + 1:
		var f := float(i) / rings
		var r: float = (0.78 + 0.30 * smoothstep(0.0, 0.18, f)) * maxf(0.012, pow(1.0 - smoothstep(0.28, 1.0, f), 0.55))
		var row := []
		for s in segs + 1:
			var a := TAU * s / segs
			row.append([Vector3(r * cos(a), -f, r * sin(a)), Vector2(float(s) / segs, f)])
		grid.append(row)
	for i in rings:
		for s in segs:
			var a: Array = grid[i][s]
			var b: Array = grid[i][s + 1]
			var c: Array = grid[i + 1][s + 1]
			var d: Array = grid[i + 1][s]
			for q in [a, c, b, a, d, c]:
				st.set_uv(q[1])
				st.add_vertex(q[0])
	st.generate_normals()
	return st.commit()


static func _glow_texture() -> ImageTexture:
	var gi := Image.create(128, 128, true, Image.FORMAT_RGBA8)
	for yy in 128:
		for xx in 128:
			var rr := Vector2(xx - 63.5, yy - 63.5).length() / 64.0
			var a := clampf(1.0 - rr, 0.0, 1.0)
			gi.set_pixel(xx, yy, Color(1.0, 0.8, 0.55, a * a * a))
	gi.generate_mipmaps()
	return ImageTexture.create_from_image(gi)


# Re-creates the textures of a material with mipmaps (the glTF reader does not generate them).
static func _mipmapped(tex: Texture2D, normal := false) -> Texture2D:
	if tex == null:
		return null
	var img := tex.get_image()
	if img == null or img.has_mipmaps():
		return tex
	img.generate_mipmaps(normal)
	return ImageTexture.create_from_image(img)


static func _finish_materials(root: Node) -> void:
	for n in root.find_children("*", "MeshInstance3D", true, false):
		var mesh: Mesh = n.mesh
		for i in mesh.get_surface_count():
			var m = mesh.surface_get_material(i)
			if not (m is StandardMaterial3D):
				continue
			m.albedo_texture = _mipmapped(m.albedo_texture)
			m.roughness_texture = _mipmapped(m.roughness_texture)
			m.metallic_texture = _mipmapped(m.metallic_texture)
			m.normal_texture = _mipmapped(m.normal_texture, true)
			m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
			if m.resource_name == "Skin":
				m.clearcoat_enabled = true
				m.clearcoat = 0.2
				m.clearcoat_roughness = 0.35
			elif m.resource_name == "Titanium" or m.resource_name == "Steel":
				m.cull_mode = BaseMaterial3D.CULL_DISABLED
			elif m.resource_name == "Engine":
				m.cull_mode = BaseMaterial3D.CULL_DISABLED


# Builds the stage under `vehicle` (whose local +X is the body axis). Returns
# {body, plume, outer, core, jets, haze, glow, light, materials, model}; `model` is the glTF root.
static func build(vehicle: Node3D) -> Dictionary:
	var body := Node3D.new()
	body.name = "StageIllustrative"
	body.rotation = Vector3(0, 0, -PI / 2.0)  # local +Y (the model's axis) onto the body axis +X
	vehicle.add_child(body)
	var model := Assets.load_glb("stage.glb")
	if model != null:
		body.add_child(model)
		_finish_materials(model)
	# Plume (illustrative): outer flame, merged core and one jet per engine along -y from the exit
	# plane; a faint refraction shell and a small glow.
	var flame := _flame_mesh(56, 28)
	var plume_shader: Shader = load("res://shaders/plume.gdshader")
	var mk := func(mesh: Mesh, shader: Shader, params: Dictionary) -> Array:
		var mat := ShaderMaterial.new()
		mat.shader = shader
		for k in params:
			mat.set_shader_parameter(k, params[k])
		var mi := MeshInstance3D.new()
		mi.mesh = mesh
		mi.material_override = mat
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		return [mi, mat]
	var plume := Node3D.new()
	plume.name = "PlumeIllustrative"
	body.add_child(plume)
	var haze_arr: Array = mk.call(flame, load("res://shaders/heat_haze.gdshader"), {})
	# Drawn before the flame layers: it samples the screen copy taken before the transparent pass and
	# would otherwise paint over them.
	haze_arr[1].render_priority = -10
	haze_arr[0].extra_cull_margin = 200.0
	plume.add_child(haze_arr[0])
	var outer_arr: Array = mk.call(flame, plume_shader, {"warm": Color(1.0, 0.45, 0.13), "cool": Color(0.5, 0.1, 0.04), "intensity": 1.5, "diamonds": 0.0, "body_fade": 0.0})
	outer_arr[0].extra_cull_margin = 200.0
	plume.add_child(outer_arr[0])
	var core_arr: Array = mk.call(flame, plume_shader, {"hot": Color(1.0, 0.86, 0.55), "warm": Color(1.0, 0.6, 0.25), "cool": Color(0.9, 0.3, 0.1), "intensity": 1.6, "diamonds": 1.0})
	core_arr[0].extra_cull_margin = 200.0
	plume.add_child(core_arr[0])
	var jets := []
	var spots := [Vector2.ZERO]
	for k in 6:
		spots.append(Vector2(1.12 * cos(k * PI / 3.0), 1.12 * sin(k * PI / 3.0)))
	var jet_materials := []
	for sp in spots:
		var j_arr: Array = mk.call(flame, plume_shader, {"hot": Color(1.0, 0.88, 0.62), "warm": Color(1.0, 0.66, 0.3), "cool": Color(1.0, 0.4, 0.14), "intensity": 1.0, "diamonds": 1.0})
		var ji: MeshInstance3D = j_arr[0]
		ji.position = Vector3(sp.x, 0.05, sp.y)
		ji.extra_cull_margin = 100.0
		plume.add_child(ji)
		jets.append(ji)
		jet_materials.append(j_arr[1])
	# Small nozzle glow (camera-facing), visible whenever the engine is on.
	var gm := StandardMaterial3D.new()
	gm.albedo_texture = _glow_texture()
	gm.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	gm.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	gm.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
	gm.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED
	gm.albedo_color = Color(1.0, 0.78, 0.55)
	gm.disable_fog = true
	var gq := QuadMesh.new()
	gq.size = Vector2(5.0, 5.0)
	var glow := MeshInstance3D.new()
	glow.mesh = gq
	glow.material_override = gm
	glow.position = Vector3(0, -0.6, 0)
	glow.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	plume.add_child(glow)
	# One small hot glow per engine (camera-facing), strongest when the nozzles are at the ground.
	var eglows := []
	for sp in spots:
		var em := StandardMaterial3D.new()
		em.albedo_texture = gm.albedo_texture
		em.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		em.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		em.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
		em.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED
		em.albedo_color = Color(1.0, 0.8, 0.5)
		em.disable_fog = true
		var eq := QuadMesh.new()
		eq.size = Vector2(2.4, 2.4)
		var eg := MeshInstance3D.new()
		eg.mesh = eq
		eg.material_override = em
		eg.position = Vector3(sp.x, -0.5, sp.y)
		eg.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		plume.add_child(eg)
		eglows.append(eg)
	var light := OmniLight3D.new()
	light.light_color = Color(1.0, 0.7, 0.4)
	light.omni_range = 120.0
	light.omni_attenuation = 1.6
	light.position = Vector3(0, -6, 0)
	light.shadow_enabled = false   # switched on near the ground (set_plume), where there is something to shadow
	# The plume light must not light the volumetric fog (it made a glowing ball in the haze).
	light.light_volumetric_fog_energy = 0.0
	body.add_child(light)
	var materials := [outer_arr[1], core_arr[1], haze_arr[1]]
	materials.append_array(jet_materials)
	return {"body": body, "plume": plume, "outer": outer_arr[0], "outer_mat": outer_arr[1], "core": core_arr[0], "core_mat": core_arr[1],
		"haze": haze_arr[0], "haze_mat": haze_arr[1], "eglows": eglows, "jets": jets, "jet_mats": jet_materials, "glow": glow, "light": light,
		"materials": materials, "model": model}


# Plume length in metres (0 hides it), logical time for its turbulence, the nozzle's height above the
# drawn ground, and the recorded applied throttle.
static func set_plume(s: Dictionary, length: float, logical_t: float, clear_m := INF, throttle := 0.6) -> void:
	var on := length > 0.0
	s["plume"].visible = on
	s["light"].visible = on
	if not on:
		return
	# The axial flame stops at the ground (it would otherwise be drawn inside the terrain): the
	# shaders clip at that height; the ground spread is drawn by the ground effect.
	var clip := clampf(clear_m + 0.6, 0.5, length * 1.05)
	var p_outer := {"logical_t": logical_t, "throttle": throttle, "length_m": length, "radius_m": 2.15, "clip_m": clip}
	_set_shell(s["outer"], s["outer_mat"], length, 2.15, p_outer)
	var core_len: float = maxf(3.0, length * 0.62)
	_set_shell(s["core"], s["core_mat"], core_len, 1.05, {"logical_t": logical_t, "throttle": throttle, "length_m": core_len, "radius_m": 1.05, "clip_m": clip})
	var jet_len: float = maxf(2.5, length * 0.34)
	for i in s["jets"].size():
		_set_shell(s["jets"][i], s["jet_mats"][i], jet_len, 0.42, {"logical_t": logical_t, "throttle": throttle, "length_m": jet_len, "radius_m": 0.42, "clip_m": clip})
	_set_shell(s["haze"], s["haze_mat"], length * 1.5, 4.0, {"logical_t": logical_t, "length_m": length * 1.5, "radius_m": 4.0, "clip_m": clip, "strength": 0.0035 + 0.0045 * throttle})
	var gk: float = 1.0 if clear_m > 20.0 else clampf(clear_m / 20.0, 0.2, 1.0)
	s["glow"].material_override.albedo_color = Color(1.0, 0.78, 0.55) * (0.30 + 0.30 * throttle) * maxf(gk, 0.8)
	s["light"].light_energy = 6.0 * minf(1.0, length / 28.0)
	s["light"].shadow_enabled = clear_m < 120.0
	var near_k: float = clampf(1.0 - clear_m / 60.0, 0.0, 1.0)
	for eg in s["eglows"]:
		eg.material_override.albedo_color = Color(1.0, 0.8, 0.5) * (0.25 + 0.9 * near_k) * (0.5 + 0.5 * throttle)


static func _set_shell(mi: MeshInstance3D, mat: ShaderMaterial, length: float, radius: float, params: Dictionary) -> void:
	mi.scale = Vector3(radius, length, radius)
	for k in params:
		mat.set_shader_parameter(k, params[k])
